{
  "name": "gothic-virtual-gallery",
  "version": "1.0.0",
  "description": "An immersive gothic virtual art gallery",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "node public/scripts/build.js",
    "validate": "node public/scripts/validate-manifest.js",
    "check": "node public/scripts/check.js",
    "ci": "npm run build && npm run check",
    "add:painting": "node public/scripts/add-painting.js",
    "watch": "node public/scripts/watch-manifest.js",
    "optimize:images": "node public/scripts/optimize-images.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
